# Koneksi PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret untuk menandatangani cookie sesi (minimal 32 karakter acak)
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Opsional — untuk sinkronisasi otomatis dari Google Form → Google Spreadsheet
# Isi dengan ID spreadsheet (bagian URL "/d/xxxxxxxx/edit")
GOOGLE_SHEET_ID=
# Nama sheet yang ingin diambil (opsional; bila kosong mengambil sheet pertama)
GOOGLE_SHEET_NAME=
